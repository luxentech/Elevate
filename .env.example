# Supabase Configuration
# احصل على هذه القيم من Supabase Dashboard → Settings → API

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_ID=your-project-id

# Supabase Publishable (Anonymous) Key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Vite Environment Variables (للـ Frontend)
# يجب أن تبدأ بـ VITE_ لكي تكون متاحة في المتصفح
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ملاحظات:
# 1. انسخ هذا الملف إلى .env وأضف القيم الحقيقية
# 2. لا ترفع ملف .env على GitHub أبداً!
# 3. على Vercel، أضف هذه المتغيرات في Dashboard → Settings → Environment Variables
# 4. استخدم نفس القيم لـ SUPABASE_* و VITE_SUPABASE_*
