# Vercel Ignore File
# الملفات والمجلدات اللي مش محتاج ترفعها على Vercel

# Environment files (هتضيفها يدوياً في Vercel Dashboard)
.env
.env.local
.env.*.local

# Node modules
node_modules/

# Build files
dist/
.output/

# Cache directories
.cache/
.turbo/
.next/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Git
.git/
.gitignore

